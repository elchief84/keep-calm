{
  "manifest_version": 3,
  "name": "Keep Calm",
  "version": "1.0.0",
  "description": "Think twice, send once. Analyzes messages before you send them — 100% local.",
  "permissions": ["offscreen", "storage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Keep Calm"
  }
}
