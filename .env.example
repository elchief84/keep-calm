# Keep Calm — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# Hugging Face token (optional, for higher rate limits when downloading models)
HF_TOKEN=

# Weights & Biases API key (optional, for training experiment tracking)
WANDB_API_KEY=

# Override default models directory (optional)
# KEEP_CALM_MODELS_DIR=/path/to/models
